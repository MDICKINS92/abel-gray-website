modules = ["python-base-3.13", "nodejs-24"]
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "website"

[[workflows.workflow]]
name = "website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --directory ."
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
